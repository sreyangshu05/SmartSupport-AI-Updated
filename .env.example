# Compose / production configuration
ENV=development
POSTGRES_PASSWORD=smartpass
SECRET_KEY=replace-with-a-long-random-secret-before-production
CORS_ORIGINS=http://localhost:8080
FRONTEND_URL=http://localhost:8080

# Set true only when an OpenAI-compatible provider is configured.
AI_ENABLED=false
AI_PROVIDER=openai_compat
# OpenRouter uses the OpenAI-compatible base URL below.
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
# Example OpenRouter chat model:
# AI_CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small

# In-memory sliding-window rate limiter. Auto-disabled in test env.
RATE_LIMIT_ENABLED=true

# pgvector extension powers semantic ticket/KB search when AI embeddings are
# configured. The migration enables the extension; without it the app falls
# back to keyword matching. Requires PostgreSQL with the pgvector extension.

# Local demo seed. Do not use default credentials outside local development.
SEED_DATA=true
SEED_ADMIN_EMAIL=admin@smart.support
SEED_ADMIN_PASSWORD=admin123
